# Copy to backend/.env (never commit .env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
LLM_API_KEY=
# External AI stays off until an authorized operator has reviewed the permitted use,
# paid provider account and privacy settings. See docs/ai-privacy.md.
AI_PRIVACY_PROVIDER_APPROVAL=
LLM_MODEL=gemini-3.5-flash-lite
SCAN_DAILY_LIMIT=30
CHAT_DAILY_LIMIT=100

# SOS alerts: "log" only logs (the app opens the phone's messages app instead); "twilio" sends real SMS.
NOTIFY_PROVIDER=log
DEFAULT_COUNTRY_CODE=94
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Comma-separated web origins allowed to call the API. "*" is fine for the mobile demo.
ALLOWED_ORIGINS=*

# Server-only, 32 random bytes encoded as 64 hex characters. Match the
# protected database key provisioned after migration 011.
MEDICATION_REVIEW_SIGNING_KEY=
