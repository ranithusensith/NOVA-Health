# Copy this file to .env and fill in the values. NEVER commit .env
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Only the backend may hold this. Never put it in Flutter or the repo.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Gemini API key from aistudio.google.com (free tier). Use fake data only.
LLM_API_KEY=
# Model name shown in AI Studio, for example gemini-3.5-flash
LLM_MODEL=gemini-3.5-flash
# Per-user scans per day (protects the free quota)
SCAN_DAILY_LIMIT=30
